generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum ItemCategory {
  FRUTAS_VERDURAS
  LACTEOS_HUEVOS
  CARNES_PESCADO
  PANADERIA
  LIMPIEZA
  BEBIDAS
  DESPENSA
  OTROS
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  password       String
  name           String
  familyGroupId  String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  familyGroup    FamilyGroup?  @relation("GroupMembers", fields: [familyGroupId], references: [id], onDelete: SetNull)
  createdGroups  FamilyGroup[] @relation("GroupCreator")
  createdLists   ShoppingList[] @relation("ListCreator")
  addedItems     ListItem[]    @relation("ItemAdder")
  purchasedItems ListItem[]    @relation("ItemPurchaser")

  @@index([familyGroupId])
}

model FamilyGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  inviteCode  String   @unique
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?    @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     User[]   @relation("GroupMembers")
  lists       ShoppingList[]
}

model ShoppingList {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  familyGroupId  String   @db.Uuid
  createdById    String?  @db.Uuid
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  familyGroup    FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  createdBy      User?       @relation("ListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items          ListItem[]

  @@index([familyGroupId, isArchived, updatedAt])
}

model ListItem {
  id              String       @id @default(uuid()) @db.Uuid
  shoppingListId  String       @db.Uuid
  name            String
  quantity        String?
  category        ItemCategory @default(OTROS)
  isPurchased     Boolean      @default(false)
  purchasedById   String?      @db.Uuid
  purchasedAt     DateTime?
  addedById       String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  shoppingList    ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  purchasedBy     User?        @relation("ItemPurchaser", fields: [purchasedById], references: [id], onDelete: SetNull)
  addedBy         User?        @relation("ItemAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([shoppingListId, category, isPurchased, createdAt])
}
